/* square root of a given number */

   float a, x, delta;
   int stop;

{
      read (a);
      x = a/2.0;
      stop = 0;

      while(stop == 0) {
         x = x/2.0+a/(2.0*x);
         delta =  x*x-a;

         if(delta < 0)  { delta = 0 - delta;} else { }
         if (delta < 0.0001)  { stop = 1;} else { }
       }
       write(a);
       write(x);
}
