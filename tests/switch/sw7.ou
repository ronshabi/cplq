var: int;
mult: float;
{
    input(var);
    switch (var) {
        case 0:
            mult = 70.70;
            output(var);
            break;

        case 1: {
            mult = 4.20;
            break;
        }

        case 2: {
            mult =  69;
        }

        default: {
            mult = 999;
            break;
            break;
        }
    }

    output(mult);
}